NODE_ENV=development
PORT=5000
# Used when running `npm.cmd run dev` directly on your computer.
MONGODB_URI=mongodb://localhost:27017/devops
# Used only by Docker Compose. Set this to a MongoDB Atlas URL for production if needed.
DOCKER_MONGODB_URI=mongodb://mongo:27017/campuscare
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
SEED_DEMO_DATA=true

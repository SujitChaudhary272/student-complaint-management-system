NODE_ENV=development
PORT=5000
# Used when running `npm.cmd run dev` directly on your computer.
MONGODB_URI=mongodb://127.0.0.1:27017/campuscare
# Used only by Docker Compose. Keep the service hostname for the included MongoDB container.
DOCKER_MONGODB_URI=mongodb://mongo:27017/campuscare
# Generate a unique value before deploying. Never commit the real .env file.
JWT_SECRET=replace-with-a-long-random-secret
# Leave blank when Express serves the frontend at the same public URL.
# Set only when a separate frontend origin needs CORS access.
CLIENT_URL=
SEED_DEMO_DATA=false
APP_PORT=80
